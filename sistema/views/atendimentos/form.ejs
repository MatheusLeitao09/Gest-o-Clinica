<%- include('../partials/header') %>

<h2><%= atendimento && atendimento.id ? 'Editar Atendimento' : 'Novo Atendimento' %></h2>

<% if (erro) { %>
  <div class="alert alert-danger"><%= erro %></div>
<% } %>

<form action="<%= atendimento && atendimento.id ? `/atendimentos/${atendimento.id}/editar` : '/atendimentos' %>" method="POST">
  <div class="form-group">
    <label for="crianca_id">Criança (Paciente)</label>
    <select id="crianca_id" name="crianca_id" required>
      <option value="">-- Selecione a criança --</option>
      <% criancas.forEach(c => { %>
        <option value="<%= c.id %>" <%= (atendimento && String(atendimento.crianca_id) === String(c.id)) ? 'selected' : '' %>>
          <%= c.nome %> (Resp.: <%= c.responsavel_nome %>)
        </option>
      <% }) %>
    </select>
  </div>

  <div class="form-group">
    <label for="data_atendimento">Data do Atendimento</label>
    <input type="date" id="data_atendimento" name="data_atendimento" value="<%= atendimento ? atendimento.data_atendimento : '' %>" required>
  </div>

  <div class="form-group">
    <label for="horario">Horário</label>
    <input type="time" id="horario" name="horario" value="<%= atendimento ? atendimento.horario : '' %>" required>
  </div>

  <div class="form-group">
    <label for="motivo">Motivo da Consulta</label>
    <textarea id="motivo" name="motivo" rows="3" required><%= atendimento ? atendimento.motivo : '' %></textarea>
  </div>

  <div class="form-group">
    <label for="situacao">Situação</label>
    <select id="situacao" name="situacao" required>
      <% const opcoes = ['Agendado', 'Confirmado', 'Realizado', 'Cancelado']; %>
      <% opcoes.forEach(op => { %>
        <option value="<%= op %>" <%= (atendimento && atendimento.situacao === op) ? 'selected' : '' %>>
          <%= op %>
        </option>
      <% }) %>
    </select>
  </div>

  <button type="submit" class="btn btn-primary">Salvar Atendimento</button>
  <a href="/atendimentos" class="btn btn-secondary">Cancelar</a>
</form>

<%- include('../partials/footer') %>