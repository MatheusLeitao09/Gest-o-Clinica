<%- include('../partials/header') %>

<h2><%= crianca && crianca.id ? 'Editar Criança' : 'Nova Criança' %></h2>

<% if (erro) { %>
  <div class="alert alert-danger"><%= erro %></div>
<% } %>

<form action="<%= crianca && crianca.id ? `/criancas/${crianca.id}/editar` : '/criancas' %>" method="POST">
  <div class="form-group">
    <label for="nome">Nome da Criança</label>
    <input type="text" id="nome" name="nome" value="<%= crianca ? crianca.nome : '' %>" required>
  </div>

  <div class="form-group">
    <label for="data_nascimento">Data de Nascimento</label>
    <input type="date" id="data_nascimento" name="data_nascimento" value="<%= crianca ? crianca.data_nascimento : '' %>" required>
  </div>

  <div class="form-group">
    <label for="responsavel_id">Responsável Legal (Obrigatório)</label>
    <select id="responsavel_id" name="responsavel_id" required>
      <option value="">-- Selecione um responsável --</option>
      <% responsaveis.forEach(r => { %>
        <option value="<%= r.id %>" <%= (crianca && String(crianca.responsavel_id) === String(r.id)) ? 'selected' : '' %>>
          <%= r.nome %>
        </option>
      <% }) %>
    </select>
  </div>

  <button type="submit" class="btn btn-primary">Salvar</button>
  <a href="/criancas" class="btn btn-secondary">Cancelar</a>
</form>

<%- include('../partials/footer') %>