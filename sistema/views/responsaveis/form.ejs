<%- include('../partials/header') %>

<h2><%= responsavel && responsavel.id ? 'Editar Responsável' : 'Novo Responsável' %></h2>

<% if (erro) { %>
  <div class="alert alert-danger"><%= erro %></div>
<% } %>

<form action="<%= responsavel && responsavel.id ? `/responsaveis/${responsavel.id}/editar` : '/responsaveis' %>" method="POST">
  <div class="form-group">
    <label for="nome">Nome Completo</label>
    <input type="text" id="nome" name="nome" value="<%= responsavel ? responsavel.nome : '' %>" required>
  </div>

  <div class="form-group">
    <label for="cpf">CPF</label>
    <input type="text" id="cpf" name="cpf" value="<%= responsavel ? responsavel.cpf : '' %>" placeholder="000.000.000-00" required>
  </div>

  <div class="form-group">
    <label for="email">E-mail</label>
    <input type="email" id="email" name="email" value="<%= responsavel ? responsavel.email : '' %>" required>
  </div>

  <div class="form-group">
    <label for="telefone">Telefone</label>
    <input type="text" id="telefone" name="telefone" value="<%= responsavel ? responsavel.telefone : '' %>" placeholder="(11) 99999-9999" required>
  </div>

  <button type="submit" class="btn btn-primary">Salvar</button>
  <a href="/responsaveis" class="btn btn-secondary">Cancelar</a>
</form>

<%- include('../partials/footer') %>